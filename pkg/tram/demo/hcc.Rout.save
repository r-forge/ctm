> # Global covariance joint model
> ms <- lapply(form_tss, BoxCox, data = dd, scale_shift = TRUE, prob = c(0, 1))
> # Multivariate model
> mm <- do.call(mmlt, c(ms, data = list(dd)))
> # Actual llr
